iansdell.xyz, *.iansdell.xyz {
	tls {
		dns cloudflare {env.CF_API_TOKEN}
	}
    @dock host dock.iansdell.xyz
    handle @dock {
            reverse_proxy http://192.168.88.6:3000
    }
	# Replace this placeholder response with your site's reverse_proxy or file_server.
	respond "Caddy is running for {host}" 200
}
